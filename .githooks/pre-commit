#!/usr/bin/env python3
"""Check staged content without changing the index or working tree."""
import shutil
import subprocess
import sys


def git(*arguments):
    return subprocess.check_output(["git", *arguments])


def main():
    result = subprocess.run(["git", "diff", "--cached", "--check"])
    if result.returncode:
        return result.returncode

    paths = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split(b"\0")
    failed = False
    for raw_path in filter(None, paths):
        path = raw_path.decode("utf-8", errors="surrogateescape")
        mode = git("ls-files", "--stage", "--", path).split(b" ", 1)[0]
        if mode not in (b"100644", b"100755"):
            continue
        data = git("cat-file", "blob", ":" + path)
        # Binary files have no text formatting requirements.
        if b"\0" in data:
            continue
        try:
            data.decode("utf-8")
        except UnicodeDecodeError:
            continue
        if data and not data.endswith(b"\n"):
            print(f"{path!r}: add a final newline.", file=sys.stderr)
            failed = True
        if path.endswith(".go"):
            if not shutil.which("gofmt"):
                print("Go formatting checks need gofmt. Install the Go version in backend/go.mod.", file=sys.stderr)
                return 1
            result = subprocess.run(["gofmt"], input=data, capture_output=True)
            if result.returncode:
                print(f"{path!r}: invalid Go syntax:\n{result.stderr.decode(errors='replace')}", file=sys.stderr)
                failed = True
            elif result.stdout != data:
                print(f"{path!r}: run make fmt, review the changes, and stage the intended formatting fixes.", file=sys.stderr)
                failed = True
    return int(failed)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
